# Translation Service Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Translation Model (optional, default: gpt-4)
TRANSLATION_MODEL=gpt-4

# Target Languages (optional, default: de,fr,es)
# Comma-separated list of language codes
TRANSLATION_TARGET_LANGUAGES=de,fr,es

# Exclude Categories (optional, default: recipes)
# Comma-separated list of categories to skip
TRANSLATION_EXCLUDE_CATEGORIES=recipes,drafts

# Exclude Paths (optional, default: /pages/impressum/)
# Comma-separated list of paths to skip
TRANSLATION_EXCLUDE_PATHS=/pages/impressum/,/admin/

# Cache Configuration (optional)
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_DIR=./cache/translations

# API Behavior (optional)
TRANSLATION_MAX_RETRIES=3
TRANSLATION_TIMEOUT=30
TRANSLATION_RATE_LIMIT_DELAY=1

# Language Detection (optional)
TRANSLATION_AUTO_DETECT=true
TRANSLATION_DEFAULT_SOURCE_LANG=en